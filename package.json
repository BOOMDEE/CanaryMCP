{
  "name": "canary-mcp-worker",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "db:local": "wrangler d1 migrations apply canary-mcp-db --local",
    "db:remote": "wrangler d1 migrations apply canary-mcp-db --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^5.9.3",
    "vite": "6.4.6",
    "vitepress": "^1.6.4",
    "vitest": "5.1.0",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
